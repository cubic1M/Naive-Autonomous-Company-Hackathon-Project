# Operis money-verification: environment variables
# Copy to .env and fill in real values. NEVER commit real keys. Cameron owns all keys.

# ── Database ──────────────────────────────────────────────────────────
# Neon Postgres connection string (TODO: Edwin owns the database)
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname

# ── Stripe ────────────────────────────────────────────────────────────
# Stripe secret key (test mode)
STRIPE_SECRET_KEY=sk_test_...
# Stripe webhook signing secret (from `stripe listen` locally, or the dashboard endpoint)
STRIPE_WEBHOOK_SECRET=whsec_...
# Public base URL, no trailing slash (Checkout success/cancel and Connect return URLs)
PUBLIC_BASE_URL=https://<app>.vercel.app

# ── Limits ────────────────────────────────────────────────────────────
# Rolling 24h cap on new card holds, in cents ($2,000). DAILY_HOLD_CAP_CENTS is accepted as an alias.
DAILY_ESCROW_CAP_CENTS=200000
# Per-job payout above this (cents) requires founder approval ($150)
PAYOUT_CAP_CENTS=15000

# ── Proof verification ────────────────────────────────────────────────
# OpenAI-compatible chat completions base URL (Naive's model router), e.g. https://.../v1
VERIFIER_BASE_URL=
# API key for the verifier endpoint
VERIFIER_API_KEY=
# A vision-capable model id available on that endpoint
VERIFIER_MODEL=
