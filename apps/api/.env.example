# Copy to apps/api/.env.local for local dev. Never commit real values.
DATABASE_URL=postgres://postgres:dev@localhost:55433/operis   # Neon: use the POOLED connection string
API_BASE_URL=http://localhost:3001          # this API (prod: https://api.operis.live)
PUBLIC_BASE_URL=http://localhost:3000       # Dora's web app, used for worker job links (prod: https://operis.live)

# Naïve
NAIVE_API_KEY=
NAIVE_AGENT_CEO=
NAIVE_AGENT_OPS=
NAIVE_AGENT_VERIFIER=
NAIVE_AGENT_FINANCE=
NAIVE_AGENT_SALES=
NAIVE_WEBHOOK_SECRET=
NAIVE_SESSION_BUDGET_MICRO_USD=2000000

# Our secrets (generate: openssl rand -base64 32)
ADMIN_KEY=                     # founder console (/admin?key=...) and /v1/dashboard
CRON_SECRET=                   # Vercel cron auth for /api/cron/sweep
FOUNDER_EMAIL=                 # Naïve sends approval requests and agent questions here
INTERNAL_MCP_KEY=
CALLBACK_SIGNING_SECRET=

# Mocks: USE_MOCKS=true forces every tool to its mock; MOCK_TOOLS=a,b forces specific ones
USE_MOCKS=true
MOCK_TOOLS=
MOCK_PAYMENTS=true

# SMS: Mobilerun first, then Monid AgentLine
MOBILERUN_API_KEY=
MOBILERUN_PHONE_ID=
MOBILERUN_WEBHOOK_SECRET=
MONID_API_KEY=
MONID_AGENTLINE_NUMBER_ID=
SMS_PROVIDER=mobilerun
PAUSE_OUTREACH=false

# Outreach (Andrew, services/outreach/docs/NAIVE.md). Real find_people/send_blast run when MONID_API_KEY + LINK_SIGNING_SECRET are set
LINK_SIGNING_SECRET=
OUTREACH_LIVE=false            # true = really send email/SMS
OUTREACH_TEST_ALLOWLIST=       # our own emails/phones that get real messages even when not live
OUTREACH_MAX_SPEND_USD=0.5
AGENTMAIL_INBOX=               # e.g. ops@mail.operis.live: send outreach email via AgentMail (through Monid); wins over the Naïve inbox
OUTREACH_RADIUS_KM=8
NAIVE_OPS_IDENTITY_ID=         # Naïve identity + ops@ inbox used to send outreach email
NAIVE_OPS_INBOX_ID=

# Self-serve customer limits
MAX_OPEN_JOBS_PER_CUSTOMER=3
MAX_JOBS_PER_CUSTOMER_PER_DAY=10
MAX_JOBS_PER_DAY=60

# Stripe (Cameron)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Proof storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Limits
GEOFENCE_LAT=37.7749
GEOFENCE_LNG=-122.4194
GEOFENCE_RADIUS_M=8000
APPROVE_MIN_CONFIDENCE=0.85
PAYOUT_MAX_USD=150
