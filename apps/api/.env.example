# Copy to apps/api/.env.local for local dev. Never commit real values.
DATABASE_URL=postgres://postgres:dev@localhost:55433/operis   # Neon: use the POOLED connection string
PUBLIC_BASE_URL=http://localhost:3001

# Naïve
NAIVE_API_KEY=
NAIVE_AGENT_CEO=
NAIVE_AGENT_OPS=
NAIVE_AGENT_VERIFIER=
NAIVE_AGENT_FINANCE=
NAIVE_AGENT_SALES=
NAIVE_WEBHOOK_SECRET=
NAIVE_SESSION_BUDGET_MICRO_USD=2000000

# Our secrets (generate: openssl rand -base64 32)
INTERNAL_MCP_KEY=
CALLBACK_SIGNING_SECRET=

# Mocks: USE_MOCKS=true forces every tool to its mock; MOCK_TOOLS=a,b forces specific ones
USE_MOCKS=true
MOCK_TOOLS=
MOCK_PAYMENTS=true

# SMS: Mobilerun first, then Monid AgentLine
MOBILERUN_API_KEY=
MOBILERUN_PHONE_ID=
MOBILERUN_WEBHOOK_SECRET=
MONID_API_KEY=
MONID_AGENTLINE_NUMBER_ID=
SMS_PROVIDER=mobilerun
PAUSE_OUTREACH=false

# Stripe (Cameron)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Proof storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Limits
GEOFENCE_LAT=37.7749
GEOFENCE_LNG=-122.4194
GEOFENCE_RADIUS_M=8000
APPROVE_MIN_CONFIDENCE=0.85
PAYOUT_MAX_USD=150
